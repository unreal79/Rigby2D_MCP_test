# ---------------------------------------------------------------------------
# Node.js
# Installed by `npm install` inside _tools/mcp-server (ag-psd, pyodide, ...).
# ---------------------------------------------------------------------------
node_modules/

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Local artifacts
# The script reads input/ and writes output/test.rigby plus one log per run.
# input/ contents stay local except the sample project; output/ and logs/
# are generated. Ignore the directory contents, not the directory itself:
# a negated file pattern cannot re-include a file inside an ignored folder.
# ---------------------------------------------------------------------------
input/*
!input/human.rigby
output/*
!output/human_dance.gif
!output/human_dance.rigby
logs/
_INFO/
_preview/
*.backup.rigby
*.log

# Packaged Claude Desktop extension (about 7 MB): rebuild or re-download it,
# see README.md. The unpacked server in _tools/mcp-server is what we run.
*.mcpb

# ---------------------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
